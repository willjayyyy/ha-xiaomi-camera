# Checksums for the static ffmpeg pinned as FFMPEG_TAG/FFMPEG_BUILD in the
# Dockerfile. Verified at build time: pinning the URL alone still trusts
# whatever that URL serves.
#
# Regenerate when bumping the build:
#   for a in linux64 linuxarm64; do
#     curl -fsSL "https://github.com/BtbN/FFmpeg-Builds/releases/download/<TAG>/<BUILD>-$a-gpl-7.1.tar.xz" \
#       | sha256sum | sed "s|-$|<BUILD>-$a-gpl-7.1.tar.xz|"
#   done
